#!/usr/bin/env bash
# Local pre-push gate: catch ruff format/lint and mypy before CI burns a cycle.
# Install with: pixi run install-git-hooks
#   (or: bash scripts/install-git-hooks.sh)
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v pixi >/dev/null 2>&1; then
  echo "pre-push: pixi is required (https://pixi.sh)" >&2
  exit 1
fi
# --frozen: the gate checks the locked environment and never rewrites pixi.lock.
echo "pre-push: pixi run --frozen preflight-push" >&2
exec pixi run --frozen preflight-push
